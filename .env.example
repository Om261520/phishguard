# ===============================================
# PhishGuard Environment Configuration Example
# Copy to .env and configure for your environment
# ===============================================

# API & Server Configuration
PROJECT_NAME="PhishGuard"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration
DATABASE_URL="sqlite:///./phishguard.db"

# Security & Authentication (Change in production!)
JWT_SECRET_KEY="phishguard-ultra-secure-cyber-jwt-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or wildcard)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]

# Optional Future Threat Intel API Keys (Optional - base app works 100% offline)
# VIRUSTOTAL_API_KEY=your_virustotal_key_here
# GOOGLE_SAFE_BROWSING_KEY=your_google_key_here
# ABUSEIPDB_API_KEY=your_abuseipdb_key_here
